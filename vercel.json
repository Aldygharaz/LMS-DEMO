{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|brand/|sw.js|workbox-.*|manifest.webmanifest|favicon.*).*)",
      "destination": "/index.html"
    }
  ]
}